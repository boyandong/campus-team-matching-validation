/* 首页样式 */
.page {
  min-height: 100vh;
  padding-bottom: 120rpx;
  background-color: #F8FBFF;
}

/* 头部 */
.header {
  padding: 40rpx 30rpx 20rpx;
  background: linear-gradient(135deg, #4A90E2 0%, #357ABD 100%);
  color: #fff;
}

.slogan {
  font-size: 36rpx;
  font-weight: bold;
  text-align: center;
  line-height: 1.5;
}

/* 类型筛选 */
.type-scroll {
  background: #fff;
  padding: 20rpx 0;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  white-space: nowrap;
}

.type-list {
  display: inline-flex;
  padding: 0 20rpx;
}

.type-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 24rpx;
  margin-right: 20rpx;
  border-radius: 12rpx;
  background-color: #F5F7FA;
  transition: all 0.3s;
}

.type-item.active {
  background-color: #4A90E2;
  color: #fff;
}

.type-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.type-name {
  font-size: 24rpx;
}

.type-item.active .type-name {
  color: #fff;
  font-weight: bold;
}

/* 组队列表 */
.team-list {
  padding: 0 30rpx;
}

.team-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s;
}

.team-card:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

/* 卡片头部 */
.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.type-badge {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  color: #fff;
  font-size: 24rpx;
}

.badge-icon {
  margin-right: 6rpx;
}

.badge-text {
  font-weight: bold;
}

.create-time {
  font-size: 22rpx;
}

/* 标题 */
.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
  line-height: 1.4;
}

/* 描述 */
.card-desc {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 16rpx;
}

/* 标签 */
.card-tags {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 16rpx;
}

.tag-item {
  display: inline-block;
  padding: 6rpx 16rpx;
  margin-right: 12rpx;
  margin-bottom: 12rpx;
  background-color: #E8F4FF;
  color: #4A90E2;
  border-radius: 6rpx;
  font-size: 24rpx;
}

/* 底部信息 */
.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid #F0F0F0;
}

.footer-left {
  flex: 1;
}

.creator {
  font-size: 24rpx;
}

.footer-right {
  display: flex;
  gap: 20rpx;
  font-size: 24rpx;
  color: #999;
}

.members, .location {
  white-space: nowrap;
}

/* 反馈按钮 */
.feedback-btn {
  position: fixed;
  bottom: 200rpx;
  right: 40rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50rpx;
  background-color: #FF9800;
  box-shadow: 0 8rpx 20rpx rgba(255, 152, 0, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 50rpx;
  z-index: 99;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

