/* 发布组队页样式 */
.page {
  min-height: 100vh;
  background-color: #F8FBFF;
}

/* 头部 */
.header {
  background: linear-gradient(135deg, #4A90E2 0%, #357ABD 100%);
  padding: 40rpx 30rpx 50rpx;
  color: #fff;
}

.header-title {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.header-desc {
  font-size: 26rpx;
  opacity: 0.9;
}

/* 表单容器 */
.form-container {
  padding: 30rpx;
}

/* 表单组 */
.form-group {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
}

.form-label {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
}

.required {
  color: #FF4444;
  margin-right: 6rpx;
  font-size: 32rpx;
}

/* 输入框 */
.form-input {
  width: 100%;
  padding: 20rpx;
  border: 2rpx solid #E8E8E8;
  border-radius: 8rpx;
  font-size: 28rpx;
  background-color: #F8F8F8;
}

.form-input:focus {
  border-color: #4A90E2;
  background-color: #fff;
}

/* 选择器 */
.picker-display {
  display: flex;
  align-items: center;
  padding: 20rpx;
  border: 2rpx solid #E8E8E8;
  border-radius: 8rpx;
  background-color: #F8F8F8;
}

.type-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.type-name {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.arrow {
  font-size: 40rpx;
  color: #999;
}

/* 文本域 */
.form-textarea {
  width: 100%;
  min-height: 200rpx;
  padding: 20rpx;
  border: 2rpx solid #E8E8E8;
  border-radius: 8rpx;
  font-size: 28rpx;
  line-height: 1.6;
  background-color: #F8F8F8;
}

.form-textarea:focus {
  border-color: #4A90E2;
  background-color: #fff;
}

/* 输入提示 */
.input-tip {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #999;
  text-align: right;
}

/* 提示框 */
.tips-box {
  background: #FFF9E6;
  border-left: 4rpx solid #FFB800;
  padding: 24rpx;
  margin-bottom: 40rpx;
  border-radius: 8rpx;
}

.tips-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #FF8800;
  margin-bottom: 12rpx;
}

.tips-content {
  font-size: 26rpx;
  color: #996600;
  line-height: 1.8;
  white-space: pre-line;
}

/* 提交按钮 */
.submit-btn {
  width: 100%;
  padding: 28rpx 0;
  background: linear-gradient(135deg, #4A90E2 0%, #357ABD 100%);
  color: #fff;
  text-align: center;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: bold;
  box-shadow: 0 8rpx 20rpx rgba(74, 144, 226, 0.3);
  transition: all 0.3s;
}

.submit-btn:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(74, 144, 226, 0.3);
}

