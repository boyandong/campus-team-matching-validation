<!-- 组队详情页 -->
<view class="page" wx:if="{{team}}">
  
  <!-- 头部信息 -->
  <view class="header-section">
    <view class="type-badge" style="background-color: {{team.typeColor}}">
      <text class="badge-icon">{{team.typeIcon}}</text>
      <text class="badge-text">{{team.typeName}}</text>
    </view>
    
    <view class="title">{{team.title}}</view>
    
    <view class="meta-info">
      <text class="meta-item">👤 {{team.creator}}</text>
      <text class="meta-item">📅 {{team.createTime}}</text>
    </view>
  </view>

  <!-- 组队描述 -->
  <view class="section">
    <view class="section-title">📝 组队描述</view>
    <view class="section-content">{{team.description}}</view>
  </view>

  <!-- 基本信息 -->
  <view class="section">
    <view class="section-title">ℹ️ 基本信息</view>
    <view class="info-list">
      <view class="info-item">
        <text class="info-label">成员人数</text>
        <text class="info-value">{{team.members}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">活动地点</text>
        <text class="info-value">{{team.location}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">截止时间</text>
        <text class="info-value">{{team.deadline}}</text>
      </view>
    </view>
  </view>

  <!-- 标签 -->
  <view class="section">
    <view class="section-title">🏷️ 相关标签</view>
    <view class="tags-wrapper">
      <view wx:for="{{team.tags}}" wx:key="index" class="tag-item">
        {{item}}
      </view>
    </view>
  </view>

  <!-- 成员要求 -->
  <view class="section" wx:if="{{team.requirements && team.requirements.length > 0}}">
    <view class="section-title">✅ 成员要求</view>
    <view class="requirements-list">
      <view wx:for="{{team.requirements}}" wx:key="index" class="requirement-item">
        <text class="bullet">•</text>
        <text class="requirement-text">{{item}}</text>
      </view>
    </view>
  </view>

  <!-- 底部操作按钮 -->
  <view class="action-buttons">
    <view class="btn btn-secondary" bindtap="onChatTap">
      💬 聊一聊
    </view>
    <view class="btn btn-primary" bindtap="onJoinTap">
      ✨ 加入组队
    </view>
  </view>

</view>

<!-- 加载状态 -->
<view class="loading" wx:else>
  <text>加载中...</text>
</view>

